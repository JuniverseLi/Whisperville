# Required for live-town decisions. Without a provider the town pauses.
# Any provider implementing POST <base URL>/chat/completions can be used.
# Keep this file free of real credentials. Copy to .env to configure locally.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Per-game actual request limit. Live audit records restore usage after restart.
LLM_MAX_CALLS_PER_GAME=12
PORT=5173

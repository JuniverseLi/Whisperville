{
  "name": "whisperville",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A little town. A wandering rumor. A chance to change the story.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "experiment": "node scripts/experiment.mjs",
    "replay:model": "node scripts/replay-model-study.mjs",
    "replay:town": "node scripts/replay-town.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.6.2",
    "vite": "^8.3.6"
  }
}
